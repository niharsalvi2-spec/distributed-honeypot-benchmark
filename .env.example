# Benchmark Suite Environment Configuration
BENCHMARK_ENV=development
BENCHMARK_SEED=42
LOG_LEVEL=INFO

# Central Collector Configuration
COLLECTOR_HOST=127.0.0.1
COLLECTOR_PORT=8000
COLLECTOR_API_KEY=dev_insecure_key_change_in_prod

# MongoDB Persistence
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=honeypot_benchmark

# Sensor Ports
COWRIE_SSH_PORT=2222
OPENCANARY_FTP_PORT=2121
DIONAEA_SMB_PORT=4450
HTTP_DECOY_PORT=8080

# Distributed Clock Configuration
CLOCK_MODE=VECTOR_CLOCK
CLOCK_SKEW_SIMULATION_MS=250
